{
  "name": "chatgpt-github-mcp-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted ChatGPT MCP App that uses a GitHub App to read repositories and create safe branch + PR based code changes.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "generate:secrets": "node scripts/generate-secrets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@octokit/auth-app": "8.2.0",
    "@octokit/rest": "22.0.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jose": "6.2.3",
    "minimatch": "^10.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/supertest": "7.2.0",
    "supertest": "7.2.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
