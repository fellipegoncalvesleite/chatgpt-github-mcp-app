# 基础服务
NODE_ENV=production
PORT=3000
# 必须是公网 HTTPS，例如 https://github-mcp.example.com
PUBLIC_BASE_URL=https://your-domain.example.com

# GitHub App
# GitHub App 的 App ID，不是 Client ID
GITHUB_APP_ID=123456
# 三选一：推荐挂载私钥文件路径
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_PRIVATE_KEY_BASE64=base64_encoded_pem
# 可选：指定安装 ID；不填则按仓库自动查询 installation
# GITHUB_INSTALLATION_ID=12345678

# 仓库访问范围：生产环境建议显式白名单，逗号分隔 owner/repo
GITHUB_ALLOWED_REPOSITORIES=yourname/your-repo
# 不推荐生产开启；开启后允许所有已安装仓库
ALLOW_ALL_INSTALLED_REPOS=false

# 安全策略
BRANCH_PREFIX=chatgpt/
ALLOW_DEFAULT_BRANCH_WRITE=false
ALLOW_MERGE=false
ALLOW_DELETE_BRANCH=false
ALLOW_WORKFLOW_EDITS=false
PROTECTED_PATH_PATTERNS=**/.env,**/.env.*,**/*.pem,**/*.key,**/id_rsa,**/id_ed25519
MAX_FILES_PER_CHANGE=30
MAX_FILE_BYTES=300000
MAX_READ_FILE_BYTES=1000000
MAX_TOTAL_CHANGE_BYTES=2000000
MAX_TREE_ENTRIES=5000
MAX_HTTP_BODY_BYTES=3000000

# OAuth：先运行 npm run generate:secrets 生成
OAUTH_SIGNING_SECRET=replace-with-random-64-chars
OAUTH_ADMIN_PASSWORD_HASH=scrypt:replace:replace
OAUTH_STORE_PATH=data/oauth-store.json
# ChatGPT OAuth 回调域名；一般保留默认即可
OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,openai.com,localhost,127.0.0.1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# 审计日志
AUDIT_LOG_PATH=data/audit.jsonl
