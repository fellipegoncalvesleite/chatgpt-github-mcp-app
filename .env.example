# Public gateway
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example.com

# GitHub App
GITHUB_APP_ID=123456
# Choose one private-key source. A mounted file is recommended.
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_PRIVATE_KEY_BASE64=base64_encoded_pem
# GITHUB_INSTALLATION_ID=12345678

# Repository scope
GITHUB_ALLOWED_REPOSITORIES=yourname/your-repo
ALLOW_ALL_INSTALLED_REPOS=false

# GitHub write policy
BRANCH_PREFIX=chatgpt/
ALLOW_DEFAULT_BRANCH_WRITE=false
ALLOW_MERGE=false
ALLOW_DELETE_BRANCH=false
ALLOW_WORKFLOW_EDITS=false
PROTECTED_PATH_PATTERNS=**/.env,**/.env.*,**/*.pem,**/*.key,**/id_rsa,**/id_ed25519
MAX_FILES_PER_CHANGE=30
MAX_FILE_BYTES=300000
MAX_READ_FILE_BYTES=1000000
MAX_TOTAL_CHANGE_BYTES=2000000
MAX_TREE_ENTRIES=5000
MAX_HTTP_BODY_BYTES=3000000

# OAuth
# Generate values with: npm run generate:secrets -- 'your admin password'
OAUTH_SIGNING_SECRET=replace-with-random-64-chars
OAUTH_ADMIN_PASSWORD_HASH=scrypt:replace:replace
OAUTH_STORE_PATH=data/oauth-store.json
OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,openai.com,localhost,127.0.0.1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Optional Gmail integration (configure all four together)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCOUNT_EMAIL=

# Optional Mac local agent
# Use the same high-entropy token on the public gateway and the Mac.
LOCAL_AGENT_TOKEN=
LOCAL_AGENT_RPC_TIMEOUT_MS=300000
LOCAL_AGENT_POLL_WAIT_MS=25000
LOCAL_AGENT_MAX_OUTPUT_BYTES=500000
LOCAL_AGENT_MAX_FILE_BYTES=1000000
LOCAL_AGENT_MAX_TERMINAL_BYTES=1000000
LOCAL_AGENT_MAX_SESSIONS=16
LOCAL_AGENT_MAX_COMMAND_TIMEOUT_MS=120000

# Audit log
AUDIT_LOG_PATH=data/audit.jsonl

# Mac-only variables belong in ~/.config/chatgpt-local-agent.env, not in Railway:
# LOCAL_AGENT_GATEWAY_URL=https://your-domain.example.com
# LOCAL_AGENT_TOKEN=same-token-as-gateway
# LOCAL_AGENT_ID=optional-stable-machine-name
# LOCAL_AGENT_POLL_WAIT_MS=25000
# LOCAL_AGENT_MAX_OUTPUT_BYTES=500000
# LOCAL_AGENT_MAX_FILE_BYTES=1000000
# LOCAL_AGENT_MAX_TERMINAL_BYTES=1000000
# LOCAL_AGENT_MAX_SESSIONS=16
# LOCAL_AGENT_MAX_COMMAND_TIMEOUT_MS=120000
